# Root orchestration
ENVIRONMENT=development

# Backend
# If credentials contain reserved characters like #, encode them in the URL as %23.
DATABASE_URL=postgresql://user:pass@localhost:5432/agentsabha
DIRECT_URL=postgresql://user:pass@localhost:5432/agentsabha
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
WHATSAPP_TOKEN=EAAxxxxxxxx
WHATSAPP_PHONE_ID=1234567890
WHATSAPP_VERIFY_TOKEN=your-random-verify-token
WHATSAPP_APP_SECRET=xxxxxxxx
UIDAI_AUA_CODE=your-aua-code
UIDAI_ASA_CODE=your-asa-code
UIDAI_LICENSE_KEY=your-license-key
ENCRYPTION_KEY=generate-32-byte-base64-key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=agentsabha-briefs
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
SECRET_KEY=generate-random-64-char-string
CORRECT_CONSTITUENCY_MINIMUM_CLUSTER_SIZE=50
TATKAL_SEVERITY_THRESHOLD=8.0
TATKAL_NEW_REPORTS_THRESHOLD=50
TATKAL_MAX_AGE_HOURS=24

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
